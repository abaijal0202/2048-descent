# ---- Android / Gradle ----
# Note: gradle/wrapper/gradle-wrapper.jar IS committed on purpose — it is how the
# wrapper bootstraps on a fresh clone.
!gradle/wrapper/gradle-wrapper.jar
*.iml
.gradle/
local.properties
.idea/
.DS_Store
build/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.ap_
*.dex
release/

# ---- Signing: never commit these ----
*.jks
*.keystore
keystore.properties
signing.properties

# ---- Misc ----
node_modules/
*.log
